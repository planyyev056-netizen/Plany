import 'package:flutter/material.dart';


void main() {

runApp(const EcommerceApp());

}


class EcommerceApp extends StatelessWidget {

const EcommerceApp({Super.key});


@override

Widget build(BuildContext context) {

return MaterialApp(

title: 'E-Commerce App',

debugShowCheckedModeBanner: false,

theme: ThemeData(

useMaterial3: true,

colorScheme: ColorScheme.fromSeed(

seedColor: const Color(0xFF0D6EFD),

brightness: Brightness.light,

),

),

home: const MainNavigationScreen(),

);

}

}


// Data Models

class Product {

final String id;

final String name;

final double price;

final String category;

final String imageUrl;

final double rating;


Product({

required this.id,

required this.name,

required this.price,

required this.category,

required this.imageUrl,

required this.rating,

});

}


class OrderItem {

final Product product;

int quantity;


OrderItem({required this.product, this.quantity = 1});

}


// Main Navigation Screen with Bottom Bars

class MainNavigationScreen extends StatefulWidget {

const MainNavigationScreen({Super.key});


@override

State createState() => _MainNavigationScreenState();

}


class _MainNavigationScreenState extends State {

int _currentIndex = 0;


final List _products = [

Product(

id: '1',

name: 'Wireless Kulaklyk',

price: 450.0,

category: 'Elektronika',

imageUrl: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500',

rating: 4.8,

),

Product(

id: '2',

name: 'Sport Aýakgap (Krossowka)',

price: 620.0,

category: 'Eşikler',

imageUrl: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500',

rating: 4.5,

),

Product(

id: '3',

name: 'Akylly Sagat (SmartWatch)',

price: 1200.0,

category: 'Elektronika',

imageUrl: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500',

rating: 4.9,

),

];


final List _cart = [];

final List _wishlist = [];


void _addToCart(Product product) {

setState(() {

final index = _cart.indexWhere((item) => item.product.id == product.id);

if (index >= 0) {

_cart[index].quantity++;

} else {

_cart.add(OrderItem(product: product));

}

});

ScaffoldMessenger.of(context).showSnackBar(

SnackBar(content: Text('${product.name} sebede goşuldy!')),

);

}


void _toggleWishlist(Product product) {

setState(() {

if (_wishlist.contains(product)) {

_wishlist.remove(product);

} else {

_wishlist.add(product);

}

});

}


void _addProduct(Product product) {

setState(() {

_products.add(product);

});

}


@override

Widget build(BuildContext context) {

final screens = [

CustomerHomeScreen(

products: _products,

cart: _cart,

wishlist: _wishlist,

onAddToCart: _addToCart,

onToggleWishlist: _toggleWishlist,

),

CourierPanelScreen(),

AdminPanelScreen(onAddProduct: _addProduct),

];


return Scaffold(  
  body: screens[_currentIndex],  
  bottomNavigationBar: NavigationBar(  
    selectedIndex: _currentIndex,  
    onDestinationSelected: (index) {  
      setState(() {  
        _currentIndex = index;  
      });  
    },  
    destinations: const [  
      NavigationDestination(icon: Icon(Icons.store), label: 'Dükany'),  
      NavigationDestination(icon: Icon(Icons.local_shipping), label: 'Kuryer'),  
      NavigationDestination(icon: Icon(Icons.admin_panel_settings), label: 'Admin'),  
    ],  
  ),  
);  



}

}


// 1. CUSTOMER HOME SCREEN

class CustomerHomeScreen extends StatefulWidget {

final List products;

final List cart;

final List wishlist;

final Function(Product) onAddToCart;

final Function(Product) onToggleWishlist;


const CustomerHomeScreen({

Super.key,

required this.products,

required this.cart,

required this.wishlist,

required this.onAddToCart,

required this.onToggleWishlist,

});


@override

State createState() => _CustomerHomeScreenState();

}


class _CustomerHomeScreenState extends State {

String _selectedCategory = 'Ähli';

String _searchQuery = '';


@override

Widget build(BuildContext context) {

final filteredProducts = widget.products.where((p) {

final matchesCategory = _selectedCategory == 'Ähli' || p.category == _selectedCategory;

final matchesSearch = p.name.toLowerCase().contains(_searchQuery.toLowerCase());

return matchesCategory && matchesSearch;

}).toList();


int totalCartCount = widget.cart.fold(0, (sum, item) => sum + item.quantity);  

return Scaffold(  
  appBar: AppBar(  
    title: const Text('Online Dükan'),  
    actions: [  
      Stack(  
        alignment: Alignment.center,  
        children: [  
          IconButton(  
            icon: const Icon(Icons.shopping_cart),  
            onPressed: () {  
              Navigator.push(  
                context,  
                MaterialPageRoute(  
                  builder: (context) => CartScreen(cart: widget.cart),  
                ),  
              );  
            },  
          ),  
          if (totalCartCount > 0)  
            Positioned(  
              right: 8,  
              top: 8,  
              child: CircleAvatar(  
                radius: 9,  
                backgroundColor: Colors.red,  
                child: Text(  
                  '$totalCartCount',  
                  style: const TextStyle(color: Colors.white, fontSize: 10),  
                ),  
              ),  
            )  
        ],  
      )  
    ],  
  ),  
  body: Column(  
    children: [  
      // Search & Filter  
      Padding(  
        padding: const EdgeInsets.all(12.0),  
        child: TextField(  
          onChanged: (val) => setState(() => _searchQuery = val),  
          decoration: InputDecoration(  
            hintText: 'Haryt gözle...',  
            prefixIcon: const Icon(Icons.search),  
            border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),  
          ),  
        ),  
      ),  
      SingleChildScrollView(  
        scrollDirection: Axis.horizontal,  
        child: Row(  
          children: ['Ähli', 'Elektronika', 'Eşikler', 'Öý harytlary'].map((cat) {  
            return Padding(  
              padding: const EdgeInsets.symmetric(horizontal: 4.0),  
              child: FilterChip(  
                label: Text(cat),  
                selected: _selectedCategory == cat,  
                onSelected: (selected) {  
                  setState(() => _selectedCategory = cat);  
                },  
              ),  
            );  
          }).toList(),  
        ),  
      ),  
      const SizedBox(height: 10),  
      // Product Grid  
      Expanded(  
        child: GridView.builder(  
          padding: const EdgeInsets.all(12),  
          gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(  
            crossAxisCount: 2,  
            childAspectRatio: 0.72,  
            crossAxisSpacing: 10,  
            mainAxisSpacing: 10,  
          ),  
          itemCount: filteredProducts.length,  
          itemBuilder: (context, index) {  
            final product = filteredProducts[index];  
            final isWished = widget.wishlist.contains(product);  

            return Card(  
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),  
              child: Column(  
                crossAxisAlignment: CrossAlignment.start,  
                children: [  
                  Stack(  
                    children: [  
                      ClipRRect(  
                        borderRadius: const BorderRadius.vertical(top: Radius.circular(12)),  
                        child: Image.network(  
                          product.imageUrl,  
                          height: 120,  
                          width: double.infinity,  
                          fit: BoxFit.cover,  
                        ),  
                      ),  
                      Positioned(  
                        right: 4,  
                        top: 4,  
                        child: IconButton(  
                          icon: Icon(  
                            isWished ? Icons.favorite : Icons.favorite_border,  
                            color: isWished ? Colors.red : Colors.grey,  
                          ),  
                          onPressed: () => widget.onToggleWishlist(product),  
                        ),  
                      )  
                    ],  
                  ),  
                  Padding(  
                    padding: const EdgeInsets.all(8.0),  
                    child: Column(  
                      crossAxisAlignment: CrossAlignment.start,  
                      children: [  
                        Text(product.name, style: const TextStyle(fontWeight: FontWeight.bold)),  
                        Text('${product.price} TMT', style: const TextStyle(color: Colors.green, fontWeight: FontWeight.w600)),  
                        Row(  
                          children: [  
                            const Icon(Icons.star, size: 16, color: Colors.amber),  
                            Text('${product.rating}'),  
                          ],  
                        ),  
                        const SizedBox(height: 6),  
                        SizedBox(  
                          width: double.infinity,  
                          child: ElevatedButton(  
                            style: ElevatedButton.styleFrom(  
                              backgroundColor: Theme.of(context).colorScheme.primary,  
                              foregroundColor: Colors.white,  
                            ),  
                            onPressed: () => widget.onAddToCart(product),  
                            child: const Text('Sebede goş', style: TextStyle(fontSize: 12)),  
                          ),  
                        )  
                      ],  
                    ),  
                  )  
                ],  
              ),  
            );  
          },  
        ),  
      )  
    ],  
  ),  
);  



}

}


// CART & CHECKOUT SCREEN

class CartScreen extends StatefulWidget {

final List cart;

const CartScreen({Super.key, required this.cart});


@override

State createState() => _CartScreenState();

}


class _CartScreenState extends State {

double get totalPrice => widget.cart.fold(0, (sum, item) => sum + (item.product.price * item.quantity));


@override

Widget build(BuildContext context) {

return Scaffold(

appBar: AppBar(title: const Text('Sebet')),

body: widget.cart.isEmpty

? const Center(child: Text('Sebet boş'))

: Column(

children: [

Expanded(

child: ListView.builder(

itemCount: widget.cart.length,

itemBuilder: (context, index) {

final item = widget.cart[index];

return ListTile(

leading: Image.network(item.product.imageUrl, width: 50, fit: BoxFit.cover),

title: Text(item.product.name),

subtitle: Text('${item.product.price} TMT'),

trailing: Row(

mainAxisSize: MainAxisSize.min,

children: [

IconButton(

icon: const Icon(Icons.remove_circle_outline),

onPressed: () {

setState(() {

if (item.quantity > 1) {

item.quantity--;

} else {

widget.cart.removeAt(index);

}

});

},

),

Text('${item.quantity}'),

IconButton(

icon: const Icon(Icons.add_circle_outline),

onPressed: () {

setState(() => item.quantity++);

},

),

],

),

);

},

),

),

Container(

padding: const EdgeInsets.all(16),

decoration: BoxDecoration(color: Colors.grey.shade100, borderRadius: const BorderRadius.vertical(top: Radius.circular(16))),

child: Column(

children: [

Row(

mainAxisAlignment: MainAxisAlignment.spaceBetween,

children: [

const Text('Jemi baha:', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),

Text('$totalPrice TMT', style: const TextStyle(fontSize: 18, color: Colors.green, fontWeight: FontWeight.bold)),

],

),

const SizedBox(height: 12),

SizedBox(

width: double.infinity,

child: ElevatedButton(

onPressed: () {

showDialog(

context: context,

builder: (ctx) => AlertDialog(

title: const Text('Sargyt Edildi!'),

content: const Text('Sargydyňyz üstünlikli kabul edildi. Kuryer tiz arada habarlaşar.'),

actions: [

TextButton(

onPressed: () {

setState(() => widget.cart.clear());

Navigator.pop(ctx);

Navigator.pop(context);

},

child: const Text('OK'),

)

],

),

);

},

child: const Text('Sargydy Tassykla (Checkout)'),

),

)

],

),

)

],

),

);

}

}


